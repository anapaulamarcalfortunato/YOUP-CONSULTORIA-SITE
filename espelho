    <style>
        :root { --dourado: #c5a059; --fundo: #ffffff; --texto-escuro: #111111; --texto-cinza: #666666; --borda: #e5e5e5; }
        body { margin: 0; padding: 0; font-family: 'Montserrat', sans-serif; background-color: var(--fundo); color: var(--texto-escuro); min-height: 100vh; top: 0px !important; }
        
        /* 1. CABEÇALHO SUPERIOR (FIXO) */
        .article-nav { display: flex; justify-content: space-between; align-items: center; padding: 0 5%; background-color: var(--fundo); position: sticky; top: 0; z-index: 1000; border-bottom: 1px solid var(--borda); height: 60px; box-sizing: border-box; }
        .article-nav .logo-text { color: var(--texto-escuro); font-weight: 900; font-size: 16px; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; }
        .article-nav .logo-text span { color: var(--dourado); }

        .nav-actions { display: flex; gap: 12px; align-items: center; }
        .btn-action { background: transparent; border: 1px solid var(--dourado); color: var(--dourado); padding: 6px 15px; border-radius: 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; text-decoration: none; gap: 8px; white-space: nowrap;}
        .btn-action:hover { background: var(--dourado); color: var(--texto-escuro); }
        
        #google_translate_element select { background: transparent; border: 1px solid var(--dourado); color: var(--dourado); padding: 6px 15px; border-radius: 20px; font-size: 10px; font-weight: 700; cursor: pointer; font-family: 'Montserrat', sans-serif; transition: all 0.3s ease; outline: none; text-transform: uppercase; letter-spacing: 1px; }
        #google_translate_element select:hover { background: var(--dourado); color: var(--fundo); }
        .goog-te-banner-frame.skiptranslate { display: none !important; }

        /* 2. TÍTULO GIGANTE CENTRALIZADO */
        .header-brand { text-align: center; padding: 50px 20px 25px 20px; margin: 0 auto; max-width: 1400px; }
        .page-title { font-size: 52px; font-weight: 900; margin: 0; letter-spacing: -2px; color: var(--texto-escuro); text-transform: uppercase; line-height: 1.1; }
        .page-subtitle { font-size: 13px; color: var(--texto-cinza); margin: 10px 0 0; font-weight: 400; text-transform: uppercase; letter-spacing: 4px; }

        /* 3. MENU DE CATEGORIAS */
        .editorial-nav-wrapper { position: sticky; top: 60px; z-index: 999; background: var(--fundo); padding: 0 5%; border-top: 2px solid var(--texto-escuro); border-bottom: 1px solid var(--borda); box-shadow: 0 4px 10px rgba(0,0,0,0.03); margin-bottom: 30px;}
        .editorial-nav { display: flex; justify-content: space-between; align-items: center; max-width: 1400px; margin: 0 auto; padding: 15px 0; }
        
        .filter-container { display: flex; gap: 25px; flex-wrap: wrap; align-items: center;}
        .filter-btn { background: none; border: none; font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--texto-cinza); cursor: pointer; padding: 0; transition: 0.3s; position: relative; }
        .filter-btn:hover, .filter-btn.active { color: var(--texto-escuro); }
        
        .search-input { border: none; border-bottom: 1px solid var(--borda); padding: 5px 0; font-family: 'Montserrat', sans-serif; font-size: 11px; outline: none; width: 180px; transition: 0.3s; background: transparent; }
        .search-input:focus { border-color: var(--dourado); width: 230px; }

        /* CONTAINERS GERAIS */
        .container { max-width: 1400px; margin: 0 auto; padding: 0 50px; }
        .section-title { font-size: 18px; font-weight: 900; text-transform: uppercase; color: var(--texto-escuro); margin-bottom: 25px; border-bottom: 2px solid var(--texto-escuro); padding-bottom: 10px; letter-spacing: 1px;}

        /* PUBLICIDADE */
        .ad-space-container { width: 100%; max-width: 1400px; margin: 30px auto; padding: 10px 0; text-align: center; background-color: #fafafa; border-top: 1px dashed var(--borda); border-bottom: 1px dashed var(--borda); }
        .ad-space-label { font-size: 8px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--texto-cinza); margin-bottom: 5px; font-weight: 800; }

        /* RADAR TEMPO REAL */
        .live-news-section { background: #fafafa; border: 1px solid var(--borda); padding: 10px 30px; margin: 0 auto 40px auto; border-radius: 4px; overflow: hidden; position: relative; max-width: 1300px; }
        .live-news-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid var(--borda); }
        .live-news-title { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: var(--texto-escuro); display: flex; align-items: center; gap: 8px; }
        .live-news-pulse { width: 6px; height: 6px; background-color: #25D366; border-radius: 50%; display: inline-block; box-shadow: 0 0 6px #25D366; animation: pulse 2s infinite; }
        
        .live-news-carousel-wrapper { position: relative; display: flex; align-items: center; }
        .live-news-track { display: flex; overflow-x: auto; gap: 15px; scroll-behavior: smooth; scrollbar-width: none; width: 100%; padding-bottom: 5px; }
        .live-news-track::-webkit-scrollbar { display: none; }
        
        .live-news-card { background: #ffffff; border: 1px solid var(--borda); border-left: 3px solid var(--dourado); padding: 8px 15px; border-radius: 4px; display: flex; flex-direction: column; justify-content: center; gap: 3px; transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; color: var(--texto-escuro); min-height: 60px; min-width: calc(25% - 12px); flex-shrink: 0; }
        .live-news-card:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        .live-news-card-tag { font-size: 8px; font-weight: 800; text-transform: uppercase; color: var(--dourado); letter-spacing: 1px; margin: 0; }
        .live-news-card-title { font-size: 12px; font-weight: 700; line-height: 1.4; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

        .carousel-btn { position: absolute; z-index: 10; background: var(--cinza-escuro); color: var(--dourado); border: 1px solid var(--dourado); border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.3s; font-size: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.2);}
        .carousel-btn.prev { left: -10px; }
        .carousel-btn.next { right: -10px; }

        /* PRINCIPAIS NOTÍCIAS (TRIAD) - ESPAÇO 1 */
        .exame-hero-triad { display: flex; gap: 35px; padding-bottom: 15px; align-items: stretch; margin-bottom: 40px;}
        .side-col-left { display: flex; flex-direction: column; gap: 25px; width: 280px; flex-shrink: 0; order: 1; }
        .side-news-card-left { text-decoration: none; color: var(--texto-escuro); border-bottom: 1px solid var(--borda); padding-bottom: 20px; transition: 0.3s; }
        .side-news-card-left:hover .side-news-title { color: var(--dourado); }
        .side-news-img-wrapper { width: 100%; height: 140px; overflow: hidden; border-radius: 4px; margin-bottom: 12px; background: #eee; }
        .side-news-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }

        .center-hero-rotator { position: relative; background: #ffffff; border-radius: 4px; overflow: hidden; border: 1px solid var(--borda); display: flex; flex-direction: column; flex: 1; order: 2;}
        #rotatorSlidesWrapper { display: flex; flex: 1; flex-direction: column; width: 100%; }
        .rotator-badge { position: absolute; top: 15px; left: 15px; background: rgba(17, 11, 11, 0.85); color: var(--dourado); border: 1px solid var(--dourado); padding: 4px 10px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; border-radius: 3px; z-index: 10; display: flex; align-items: center; gap: 6px; }
        .rotator-live-dot { width: 6px; height: 6px; background-color: #25D366; border-radius: 50%; display: inline-block; box-shadow: 0 0 6px #25D366; }
        .rotator-nav-btns { position: absolute; top: 40%; width: 100%; display: flex; justify-content: space-between; padding: 0 10px; pointer-events: none; z-index: 10; transform: translateY(-50%); }
        .rotator-btn { pointer-events: auto; background: rgba(0, 0, 0, 0.4); color: var(--fundo); border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.3s; font-size: 14px; outline: none; }
        .rotator-btn:hover { background: var(--dourado); color: var(--texto-escuro); border-color: var(--dourado); }
        .rotator-slide { display: none; flex-direction: column; text-decoration: none; color: var(--texto-escuro); transition: opacity 0.5s ease-in-out; flex: 1; }
        .rotator-slide.active { display: flex; animation: fadeInSlide 0.6s ease; }
        @keyframes fadeInSlide { from { opacity: 0; transform: scale(0.99); } to { opacity: 1; transform: scale(1); } }
        .rotator-img-container { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #111; }
        .rotator-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .rotator-body { padding: 25px 20px 20px; display: flex; flex-direction: column; justify-content: flex-start; flex: 1; }
        .rotator-tag { font-size: 10px; font-weight: 800; text-transform: uppercase; color: var(--dourado); letter-spacing: 1.5px; margin-bottom: 8px; display: block; }
        .rotator-title { font-size: 26px; font-weight: 800; line-height: 1.2; margin: 0 0 12px; letter-spacing: -0.5px; }
        .rotator-excerpt { font-size: 14px; color: var(--texto-cinza); line-height: 1.6; margin: 0; }
        .rotator-progress-bar { height: 3px; background: #e5e5e5; width: 100%; position: relative; }
        .rotator-progress-fill { height: 100%; background: var(--dourado); width: 0%; transition: width 0.1s linear; }

        .side-col-right { display: flex; flex-direction: column; gap: 12px; width: 280px; flex-shrink: 0; height: 100%; order: 3;}
        .side-news-item { text-decoration: none; color: var(--texto-escuro); border-bottom: 1px solid var(--borda); padding-bottom: 12px; transition: 0.3s; }
        .side-news-item:hover .side-news-title { color: var(--dourado); }
        .side-news-tag { font-size: 9px; font-weight: 800; text-transform: uppercase; color: var(--texto-cinza); letter-spacing: 1px; margin-bottom: 6px; display: block; }
        .side-news-title { font-size: 14px; font-weight: 700; line-height: 1.35; margin: 0 0 6px; transition: color 0.3s; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

        /* ========================================================================= */
        /* QUADRANTE CURTAS / SEGUNDO ESPAÇO (ESTILO PORTAL DE NOTÍCIAS) */
        /* ========================================================================= */
        .curtas-section { margin-bottom: 40px; }
        .curtas-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
        .curtas-column { display: flex; flex-direction: column; gap: 15px; border-right: 1px solid var(--borda); padding-right: 20px; }
        .curtas-column:last-child { border-right: none; padding-right: 0; }
        
        .curtas-featured-card { text-decoration: none; color: var(--texto-escuro); display: flex; flex-direction: column; gap: 8px; }
        .curtas-featured-card:hover .curtas-featured-title { color: var(--dourado); }
        .curtas-featured-img-wrapper { width: 100%; height: 160px; border-radius: 4px; overflow: hidden; background: #f0f0f0; }
        .curtas-featured-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
        .curtas-featured-card:hover .curtas-featured-img { transform: scale(1.03); }
        .curtas-featured-tag { font-size: 9px; font-weight: 800; text-transform: uppercase; color: var(--dourado); letter-spacing: 1px; }
        .curtas-featured-title { font-size: 16px; font-weight: 800; line-height: 1.3; margin: 0; transition: color 0.2s; }
        
        .curtas-list { display: flex; flex-direction: column; gap: 12px; margin-top: 5px; border-top: 1px solid var(--borda); padding-top: 12px; }
        .curtas-list-item { text-decoration: none; color: var(--texto-escuro); font-size: 13px; font-weight: 700; line-height: 1.35; position: relative; padding-left: 14px; transition: color 0.2s; }
        .curtas-list-item::before { content: "▪"; position: absolute; left: 0; color: var(--dourado); font-size: 12px; top: -1px; }
        .curtas-list-item:hover { color: var(--dourado); }

        /* FAIXA DE COLUNISTAS */
        .colunistas-carousel-section { padding: 0; margin-bottom: 20px;}
        .colunistas-header { text-align: center; margin-bottom: 30px; position: relative; }
        .colunistas-header h2 { display: inline-block; font-size: 24px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; background: var(--fundo); padding: 0 20px; position: relative; z-index: 2; margin: 0; color: var(--texto-escuro);}
        .colunistas-header::before { content: ''; position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--texto-escuro); z-index: 1; }
        
        .colunistas-carousel-wrapper { position: relative; display: flex; align-items: center; }
        .colunistas-track { display: flex; gap: 20px; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; padding: 10px 5px; width: 100%; cursor: grab; }
        .colunistas-track::-webkit-scrollbar { display: none; }
        
        .colunista-card { flex: 0 0 calc(25% - 15px); background: #fdfdfd; border: 1px solid var(--borda); border-radius: 8px; padding: 25px 20px; text-decoration: none; display: flex; flex-direction: column; align-items: center; text-align: center; transition: all 0.3s ease; position: relative; overflow: hidden; user-select: none; }
        .colunista-card:hover, .colunista-card.active { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.08); border-color: var(--dourado); }
        .colunista-card-img { width: 90px; height: 90px; border-radius: 50%; object-fit: cover; border: 3px solid var(--dourado); margin-bottom: 15px; pointer-events: none; }
        .colunista-card-name { font-size: 15px; font-weight: 800; color: var(--texto-escuro); text-transform: uppercase; margin-bottom: 5px; letter-spacing: 1px; pointer-events: none;}
        .colunista-card-theme { font-size: 11px; color: var(--dourado); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 800; pointer-events: none;}

        /* ÚLTIMAS COLUNAS */
        .ultimas-colunas-section { margin-bottom: 20px;}
        .ultimas-colunas-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
        .coluna-news-card { background: #fff; border: 1px solid var(--borda); border-radius: 8px; overflow: hidden; transition: 0.3s; text-decoration: none; color: var(--texto-escuro); display: flex; flex-direction: column;}
        .coluna-news-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.08); border-color: var(--dourado); }
        .coluna-news-img { width: 100%; height: 180px; object-fit: cover; }
        .coluna-news-body { padding: 20px; display: flex; flex-direction: column; flex: 1;}
        .coluna-news-tag { font-size: 10px; font-weight: 800; color: var(--dourado); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;}
        .coluna-news-title { font-size: 16px; font-weight: 700; line-height: 1.3; margin: 0 0 10px;}
        .coluna-news-excerpt { font-size: 13px; color: var(--texto-cinza); line-height: 1.5; margin: 0;}

        /* ACERVO */
        .editorial-feed { display: flex; flex-direction: column; }
        .list-articles-wrapper { display: grid; grid-template-columns: 1fr 1fr; column-gap: 50px; row-gap: 0; }
        .list-article { text-decoration: none; color: var(--texto-escuro); display: flex; flex-direction: row; align-items: center; gap: 20px; border-bottom: 1px solid var(--borda); padding: 25px 0; transition: opacity 0.3s; }
        .list-article:hover { opacity: 0.85; }
        .list-article .img-wrapper { width: 120px; height: 90px; flex-shrink: 0; }
        .list-article .article-img { width: 100%; height: 100%; object-fit: cover; background: #eee; }
        .list-article .content-wrapper { flex: 1; }
        .list-article .article-tag { font-size: 10px; font-weight: 800; text-transform: uppercase; color: var(--dourado); letter-spacing: 1.5px; margin-bottom: 5px; display: block; }
        .list-article .article-title { font-size: 16px; font-weight: 700; line-height: 1.3; margin: 0 0 5px; }

        .no-results { text-align: center; padding: 60px; color: var(--texto-cinza); font-style: italic; display: none; width: 100%; }
        .load-more-container { text-align: center; padding: 40px 0 20px 0; margin-bottom: 20px; }
        .btn-load-more { background: transparent; color: var(--texto-escuro); border: 1px solid var(--texto-escuro); padding: 12px 30px; font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: 0.3s; border-radius: 4px;}
        .btn-load-more:hover { background: var(--texto-escuro); color: var(--fundo); }

        /* FOOTER */
        .site-footer { background-color: #050505; color: #e5e5e5; padding: 70px 50px 40px; font-family: 'Montserrat', sans-serif; border-top: 4px solid var(--dourado); margin-top: 60px; position: relative; z-index: 10; padding-bottom: 120px; }
        .footer-content { max-width: 1400px; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 50px; }
        .footer-brand { max-width: 350px; }
        .footer-brand h2 { color: var(--fundo); font-size: 26px; margin: 0 0 15px; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; }
        .footer-brand h2 span { color: var(--dourado); }
        .footer-brand p { font-size: 13px; line-height: 1.8; color: #999; margin: 0; }
        
        .footer-nav { display: flex; gap: 80px; flex-wrap: wrap; flex: 1; justify-content: flex-end;}
        .footer-col h4 { color: var(--dourado); font-size: 15px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 25px; font-weight: 800; border-bottom: 1px solid rgba(197, 160, 89, 0.3); padding-bottom: 10px;}
        .footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 15px; }
        .footer-col ul li a { color: #bbb; text-decoration: none; font-size: 13px; font-weight: 500; transition: 0.3s; display: flex; align-items: center; gap: 8px;}
        .footer-col ul li a:hover { color: var(--fundo); padding-left: 5px;}
        .footer-bottom { max-width: 1400px; margin: 50px auto 0; padding-top: 25px; border-top: 1px solid rgba(255,255,255,0.05); text-align: center; font-size: 12px; color: #666; letter-spacing: 1px; }

        /* BANNER FIXO RODAPÉ */
        .sticky-bottom-wrapper { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 970px; z-index: 99999; display: flex; flex-direction: column; align-items: center; pointer-events: none; }
        .sticky-toggle { pointer-events: auto; background-color: #fdfdfd; border: 1px solid var(--borda); border-bottom: none; color: var(--texto-cinza); font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; padding: 10px 25px; border-radius: 8px 8px 0 0; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 -4px 10px rgba(0,0,0,0.08); }
        .sticky-toggle:hover { color: var(--dourado); }
        .sticky-ad-content { pointer-events: auto; background-color: #fdfdfd; border-top: 1px solid var(--borda); box-shadow: 0 -5px 15px rgba(0,0,0,0.1); width: 100%; padding: 10px; box-sizing: border-box; display: flex; justify-content: center; max-height: 250px; overflow: hidden; transition: max-height 0.3s ease, padding 0.3s ease; }
        .sticky-bottom-wrapper.closed .sticky-ad-content { display: none !important; height: 0 !important; max-height: 0 !important; padding: 0 !important; margin: 0 !important; border: none !important; }

        @media (max-width: 1100px) {
            .exame-hero-triad { flex-direction: column; gap: 30px; }
            .center-hero-rotator { order: 1; width: 100%; }
            .side-col-left { order: 2; width: 100%; flex-direction: row; flex-wrap: wrap; gap: 20px;}
            .side-news-card-left { width: calc(50% - 10px); border-bottom: none; padding-bottom: 0; }
            .side-col-right { order: 3; width: 100%; }
            .live-news-card { min-width: calc(50% - 10px); }
            .colunista-card { flex: 0 0 calc(33.333% - 14px); }
            .ultimas-colunas-grid { grid-template-columns: repeat(2, 1fr); }
            .curtas-grid { grid-template-columns: 1fr; }
            .curtas-column { border-right: none; border-bottom: 1px solid var(--borda); padding-right: 0; padding-bottom: 20px; }
        }

        @media (max-width: 768px) {
            .article-nav { flex-direction: column; gap: 10px; padding: 10px 20px; height: auto; }
            .nav-actions { width: 100%; justify-content: space-between; gap: 5px; flex-wrap: wrap;}
            .btn-action { font-size: 9px; padding: 6px 10px; letter-spacing: 0; }
            #google_translate_element select { font-size: 9px; padding: 6px 10px; letter-spacing: 0; }
            
            .header-brand { padding: 30px 10px 10px; margin: 0 10px; }
            .page-title { font-size: 32px; }
            .page-subtitle { font-size: 10px; }

            .editorial-nav-wrapper { top: 60px; padding: 0 15px; } 
