    <!-- SCRIPTS DE LÓGICA E RENDERIZAÇÃO -->
    <script>
        function toggleStickyAd() {
            const wrapper = document.getElementById('stickyBottomAd');
            const btn = document.querySelector('.sticky-toggle');
            wrapper.classList.toggle('closed');
            btn.innerHTML = wrapper.classList.contains('closed') ? 'PUBLICIDADE ▲' : 'FECHAR ▼';
        }

        let limiteAtual = 10; 
        let filtroAtual = 'todos';
        let autorAtual = 'todos';
        let pesquisaAtual = '';

        let slideIndexAtual = 0;
        let slideTimer = null;
        let progressTimer = null;
        const TEMPO_SLIDE = 6000; 

        function toggleColumnistsWrapper() {
            const wrapper = document.getElementById('colunistasSectionWrapper');
            const ultimasWrapper = document.getElementById('ultimasColunasWrapper');
            
            if (filtroAtual === 'colunas' || filtroAtual === 'todos') {
                if (wrapper) wrapper.style.display = 'block';
                if (ultimasWrapper && filtroAtual === 'todos') ultimasWrapper.style.display = 'block';
                else if (ultimasWrapper) ultimasWrapper.style.display = 'none';
            } else {
                if (wrapper) wrapper.style.display = 'none';
                if (ultimasWrapper) ultimasWrapper.style.display = 'none';
            }
        }

        function renderArticles() {
            toggleColumnistsWrapper();

            const triadContainer = document.getElementById('exameTriadContainer');
            const triadLeftCol = document.getElementById('triadLeftCol');
            const triadCenterWrapper = document.getElementById('rotatorSlidesWrapper');
            const triadRightCol = document.getElementById('triadRightCol');
            const curtasSectionWrapper = document.getElementById('curtasSectionWrapper');
            const curtasGridContainer = document.getElementById('curtasGridContainer');
            const ultimasColunasGrid = document.getElementById('ultimasColunasGrid');

            const listZone = document.getElementById('listZone');
            const noResultsMsg = document.getElementById('noResultsMsg');
            const btnLoadMore = document.getElementById('loadMoreContainer');
            const acervoTitle = document.getElementById('acervoTitle');
            const adSpace2 = document.getElementById('adSpace2');
            const adSpace3 = document.getElementById('adSpace3');
            
            triadLeftCol.innerHTML = ''; 
            triadCenterWrapper.innerHTML = ''; 
            triadRightCol.innerHTML = '';
            if (curtasGridContainer) curtasGridContainer.innerHTML = '';
            if (ultimasColunasGrid) ultimasColunasGrid.innerHTML = '';
            listZone.innerHTML = '';
            
            const sources = Array.from(document.querySelectorAll('#sourceArticles a'));
            
            // 1. FILTRAGEM POR DATA (Oculta agendadas) E ORDENAÇÃO MANDATÓRIA (Mais recentes primeiro)
            const dataAtual = new Date();
            let validArticles = sources.filter(a => {
                const dataAgendada = a.getAttribute('data-publish-date'); 
                if (dataAgendada) {
                    const dataPublicacao = new Date(dataAgendada + 'T00:00:00-03:00'); 
                    if (dataAtual < dataPublicacao) return false; 
                }
                if (!a.getAttribute('data-type')) {
                    if (a.getAttribute('data-author')) a.setAttribute('data-type', 'coluna');
                    else a.setAttribute('data-type', 'materia');
                }
                return true;
            }).sort((a, b) => {
                const dateA = a.getAttribute('data-publish-date') ? new Date(a.getAttribute('data-publish-date') + 'T00:00:00-03:00') : new Date(0);
                const dateB = b.getAttribute('data-publish-date') ? new Date(b.getAttribute('data-publish-date') + 'T00:00:00-03:00') : new Date(0);
                return dateB - dateA; // Decrescente
            });

            // 2. FILTRAGEM / PESQUISA ATIVA
            if (filtroAtual !== 'todos' || autorAtual !== 'todos' || pesquisaAtual !== '') {
                triadContainer.style.display = 'none';
                if(curtasSectionWrapper) curtasSectionWrapper.style.display = 'none';
                if(adSpace2) adSpace2.style.display = 'none';
                if(adSpace3) adSpace3.style.display = 'none';
                acervoTitle.innerText = "Resultados da Pesquisa";

                let filtered = validArticles.filter(a => {
                    const matchFiltro = filtroAtual === 'colunas' ? true : (a.getAttribute('data-category') === filtroAtual);
                    const matchAutor = autorAtual === 'todos' || a.getAttribute('data-author') === autorAtual;
                    const matchTexto = pesquisaAtual === '' || a.innerText.toLowerCase().includes(pesquisaAtual);
                    
                    if(filtroAtual === 'colunas' && autorAtual === 'todos' && pesquisaAtual === ''){
                        return a.getAttribute('data-type') === 'coluna';
                    }
                    return matchFiltro && matchAutor && matchTexto;
                });

                if (filtered.length === 0) {
                    noResultsMsg.style.display = 'block';
                    btnLoadMore.style.display = 'none';
                    return;
                }
                noResultsMsg.style.display = 'none';

                filtered.slice(0, limiteAtual).forEach(item => renderArticleInList(item, listZone));
                btnLoadMore.style.display = filtered.length > limiteAtual ? 'block' : 'none';

            } else {
                // EXIBIÇÃO PADRÃO (HOMEPAGE COMPLETA)
                acervoTitle.innerText = "Acervo Completo";
                triadContainer.style.display = 'flex';
                if(curtasSectionWrapper) curtasSectionWrapper.style.display = 'block';
                if(adSpace2) adSpace2.style.display = 'block';
                if(adSpace3) adSpace3.style.display = 'block';

                const materiasEArtigos = validArticles.filter(a => a.getAttribute('data-type') === 'materia' || a.getAttribute('data-type') === 'artigo');
                const colunas = validArticles.filter(a => a.getAttribute('data-type') === 'coluna');

                // --- RENDER ESPAÇO 1 (HERO TRIAD - data-spot="1" ou Automático) ---
                let triadItems = materiasEArtigos.filter(a => a.getAttribute('data-spot') === '1');
                if(triadItems.length < 10) {
                    const sobrantes = materiasEArtigos.filter(a => a.getAttribute('data-spot') !== '1' && a.getAttribute('data-spot') !== '2');
                    triadItems = triadItems.concat(sobrantes.slice(0, 19 - triadItems.length));
                }

                const DestaquesRotativos = triadItems.slice(0, 10);
                DestaquesRotativos.forEach((item, index) => {
                    const url = item.getAttribute('href');
                    const imgSrc = item.querySelector('img').src;
                    const tag = item.querySelector('.tag').innerText;
                    const title = item.querySelector('.title').innerText;
                    const excerpt = item.querySelector('.excerpt') ? item.querySelector('.excerpt').innerText : '';

                    triadCenterWrapper.innerHTML += `
                        <a href="${url}" class="rotator-slide ${index === 0 ? 'active' : ''}">
                            <div class="rotator-img-container">
                                <img src="${imgSrc}" class="rotator-img" alt="${title}">
                            </div>
                            <div class="rotator-body">
                                <span class="rotator-tag">${tag}</span>
                                <h2 class="rotator-title">${title}</h2>
                                <p class="rotator-excerpt">${excerpt}</p>
                            </div>
                        </a>
                    `;
                });
                if(DestaquesRotativos.length > 0) iniciarSliderRotativo(DestaquesRotativos.length);

                const LeftItems = triadItems.slice(10, 12);
                LeftItems.forEach(item => {
                    const url = item.getAttribute('href');
                    const imgSrc = item.querySelector('img').src;
                    const tag = item.querySelector('.tag').innerText;
                    const title = item.querySelector('.title').innerText;
                    const excerpt = item.querySelector('.excerpt') ? item.querySelector('.excerpt').innerText : '';

                    triadLeftCol.innerHTML += `
                        <a href="${url}" class="side-news-card-left">
                            <div class="side-news-img-wrapper"><img src="${imgSrc}" class="side-news-img" alt="${title}"></div>
                            <span class="side-news-tag">${tag}</span>
                            <h3 class="side-news-title">${title}</h3>
                            <p class="side-news-bullet">${excerpt}</p>
                        </a>
                    `;
                });

                const RightItems = triadItems.slice(12, 19);
                RightItems.forEach(item => {
                    const url = item.getAttribute('href');
                    const tag = item.querySelector('.tag').innerText;
                    const title = item.querySelector('.title').innerText;

                    triadRightCol.innerHTML += `
                        <a href="${url}" class="side-news-item">
                            <span class="side-news-tag">${tag}</span>
                            <h4 class="side-news-title">${title}</h4>
                        </a>
                    `;
                });

                // --- RENDER ESPAÇO 2 (QUADRANTE CURTAS - data-spot="2" ou Automático) ---
                let curtasItems = materiasEArtigos.filter(a => a.getAttribute('data-spot') === '2');
                if(curtasItems.length === 0) {
                    curtasItems = materiasEArtigos.filter(a => !triadItems.includes(a)).slice(0, 9);
                }

                if(curtasGridContainer && curtasItems.length > 0) {
                    // Divide itens em 3 colunas
                    const col1 = curtasItems.slice(0, Math.ceil(curtasItems.length / 3));
                    const col2 = curtasItems.slice(Math.ceil(curtasItems.length / 3), Math.ceil(curtasItems.length / 3) * 2);
                    const col3 = curtasItems.slice(Math.ceil(curtasItems.length / 3) * 2);

                    [col1, col2, col3].forEach(colGroup => {
                        if(colGroup.length > 0) {
                            const destaque = colGroup[0];
                            const lista = colGroup.slice(1);

                            let colHtml = `<div class="curtas-column">`;
                            
                            // Card Destaque no Topo da Coluna
                            colHtml += `
                                <a href="${destaque.getAttribute('href')}" class="curtas-featured-card">
                                    <div class="curtas-featured-img-wrapper">
                                        <img src="${destaque.querySelector('img').src}" class="curtas-featured-img" alt="${destaque.querySelector('.title').innerText}">
                                    </div>
                                    <span class="curtas-featured-tag">${destaque.querySelector('.tag').innerText}</span>
                                    <h4 class="curtas-featured-title">${destaque.querySelector('.title').innerText}</h4>
                                </a>
                            `;

                            // Lista em tópicos abaixo
                            if(lista.length > 0) {
                                colHtml += `<div class="curtas-list">`;
                                lista.forEach(itemSub => {
                                    colHtml += `
                                        <a href="${itemSub.getAttribute('href')}" class="curtas-list-item">
                                            ${itemSub.querySelector('.title').innerText}
                                        </a>
                                    `;
                                });
                                colHtml += `</div>`;
                            }

                            colHtml += `</div>`;
                            curtasGridContainer.innerHTML += colHtml;
                        }
                    });
                }

                // --- RENDER ÚLTIMAS COLUNAS ---
                const top3Colunas = colunas.slice(0, 3);
                if (ultimasColunasGrid) {
                    top3Colunas.forEach(item => {
                        const url = item.getAttribute('href');
                        const imgSrc = item.querySelector('img').src;
                        const tag = item.querySelector('.tag').innerText;
                        const title = item.querySelector('.title').innerText;
                        const excerpt = item.querySelector('.excerpt') ? item.querySelector('.excerpt').innerText : '';

                        ultimasColunasGrid.innerHTML += `
                            <a href="${url}" class="coluna-news-card">
                                <img src="${imgSrc}" class="coluna-news-img" alt="${title}">
                                <div class="coluna-news-body">
                                    <span class="coluna-news-tag">${tag}</span>
                                    <h4 class="coluna-news-title">${title}</h4>
                                    <p class="coluna-news-excerpt">${excerpt}</p>
                                </div>
                            </a>
                        `;
                    });
                }

                // --- RENDER ACERVO COMPLETO (Sempre por data mais recente) ---
                validArticles.slice(0, limiteAtual).forEach(item => {
                    renderArticleInList(item, listZone);
                });

                btnLoadMore.style.display = validArticles.length > limiteAtual ? 'block' : 'none';
            }
        }

        function renderArticleInList(item, container) {
            const url = item.getAttribute('href');
            const imgSrc = item.querySelector('img').src;
            const tag = item.querySelector('.tag').innerText;
            const title = item.querySelector('.title').innerText;

            container.innerHTML += `
                <a href="${url}" class="list-article">
                    <div class="img-wrapper"><img src="${imgSrc}" class="article-img"></div>
                    <div class="content-wrapper">
                        <span class="article-tag">${tag}</span>
                        <h3 class="article-title">${title}</h3>
                    </div>
                </a>
            `;
        }

        function reiniciarTimerSlider(totalSlides) {
            if (slideTimer) clearInterval(slideTimer);
            if (progressTimer) clearInterval(progressTimer);
            
            const progressFill = document.getElementById('rotatorProgress');
            let progresso = 0;
            if (progressFill) progressFill.style.width = '0%';

            progressTimer = setInterval(() => {
                progresso += (100 / (TEMPO_SLIDE / 100));
                if (progressFill) progressFill.style.width = `${progresso}%`;
            }, 100);

            slideTimer = setInterval(() => mudarSlideRotativo(1), TEMPO_SLIDE);
        }

        function iniciarSliderRotativo(totalSlides) {
            slideIndexAtual = 0;
            if(totalSlides > 0) reiniciarTimerSlider(totalSlides);
        }

        function mudarSlideRotativo(n, event) {
            if (event) event.preventDefault();
            const slides = document.querySelectorAll('.rotator-slide');
            if (slides.length === 0) return;

            slides[slideIndexAtual].classList.remove('active');
            slideIndexAtual = (slideIndexAtual + n + slides.length) % slides.length;
            slides[slideIndexAtual].classList.add('active');
            
            if (event) reiniciarTimerSlider(slides.length);
        }

        function carregarMaisArtigos() {
            limiteAtual += 10;
            renderArticles();
        }

        function filtrarBlog(categoria, botaoClicado) {
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.colunista-card').forEach(btn => btn.classList.remove('active'));
            if(botaoClicado) botaoClicado.classList.add('active');
            document.getElementById('searchInput').value = '';
            
            limiteAtual = 10;
            filtroAtual = categoria;
            autorAtual = 'todos';
            pesquisaAtual = '';
            renderArticles();
        }

        function filtrarPorAutor(autor, botaoClicado, event) {
            if (event) event.preventDefault();
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            
            document.querySelectorAll('.colunista-card').forEach(btn => btn.classList.remove('active'));
            if(botaoClicado) botaoClicado.classList.add('active');

            document.getElementById('searchInput').value = '';
            
            limiteAtual = 10;
            filtroAtual = 'colunas';
            autorAtual = autor;
            pesquisaAtual = '';
            renderArticles();
            
            const listZone = document.getElementById('listZone');
            if (listZone) {
                const y = listZone.getBoundingClientRect().top + window.pageYOffset - 150;
                window.scrollTo({top: y, behavior: 'smooth'});
            }
        }

        function pesquisarArtigos() {
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.colunista-card').forEach(btn => btn.classList.remove('active'));
            
            limiteAtual = 10;
            filtroAtual = 'todos';
            autorAtual = 'todos';
            pesquisaAtual = document.getElementById('searchInput').value.toLowerCase();
            renderArticles();
        }

        let carouselInterval = null;
        function scrollCarouselLiveNews(direction, isAuto = false) {
            const track = document.getElementById('liveNewsContainer');
            if (!track) return;
            const scrollAmount = track.clientWidth / 4 + 15; 

            if (!isAuto) clearInterval(carouselInterval);

            if (direction === 1) {
                if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
                    track.scrollLeft = 0; 
                } else {
                    track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                }
            } else {
                track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            }

            if (!isAuto) {
                carouselInterval = setInterval(() => scrollCarouselLiveNews(1, true), 4000);
            }
        }

        function renderManualLiveNews() {
            const container = document.getElementById('manualLiveNews');
            if (!container) return;
            container.innerHTML = '';
            
            const sources = Array.from(document.querySelectorAll('#sourceArticles a'));
            const materiasRapidas = sources.filter(a => a.getAttribute('data-type') === 'materia').slice(0, 4);
            
            materiasRapidas.forEach(item => {
                const url = item.getAttribute('href');
                const tag = item.querySelector('.tag').innerText;
                const title = item.querySelector('.title').innerText;
                
                container.innerHTML += `
                    <a href="${url}" class="live-news-card">
                        <span class="live-news-card-tag">${tag}</span>
                        <h4 class="live-news-card-title">${title}</h4>
                    </a>
                `;
            });
        }

        let colunistasInterval = null;
        function scrollColunistas(direction, isAuto = false) {
            const track = document.getElementById('colunistasContainer');
            if (!track) return;
            const scrollAmount = track.clientWidth / 3 + 20; 

            if (!isAuto) clearInterval(colunistasInterval);

            if (direction === 1) {
                if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
                    track.scrollLeft = 0; 
                } else {
                    track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                }
            } else {
                track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            }

            if (!isAuto) {
                colunistasInterval = setInterval(() => scrollColunistas(1, true), 4000);
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            renderManualLiveNews();
            renderArticles();
            
            clearInterval(colunistasInterval);
            colunistasInterval = setInterval(() => scrollColunistas(1, true), 4000);
        });
    </script>

