    <div class="sticky-bottom-wrapper" id="stickyBottomAd">
        <button class="sticky-toggle" onclick="toggleStickyAd()">FECHAR ▼</button>
        <div class="sticky-ad-content" id="stickyAdContent">
            <ins class="adsbygoogle"
                 style="display:block; width:100%;"
                 data-ad-client="ca-pub-1434753673886142"
