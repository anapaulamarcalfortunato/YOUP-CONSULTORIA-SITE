    <style>
        @page {
            size: A4 portrait;
            margin: 0;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        :root {
            --dourado: #c5a059;
            --dourado-escuro: #9e7d3b;
            --verde-youp: #5c8e82;
            --cinza-escuro: #0a0a0a;
            --cinza-card: #141414;
            --fundo-offwhite: #f4f5f7;
            --texto-corpo: #222222;
            --texto-titulo: #111111;
            --borda: #e0e0e0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--fundo-offwhite);
            color: var(--texto-corpo);
            -webkit-print-color-adjust: exact;
        }

        .slide {
            width: 210mm;
            height: 297mm;
            page-break-after: always;
            position: relative;
            overflow: hidden;
            background-color: #ffffff;
        }

        /* CAPA DA APRESENTAÇÃO */
        .slide-cover {
