            color: #ffffff;
            display: block;
            padding: 25mm 20mm;
        }

        .cover-header {
            border-bottom: 2px solid var(--dourado);
            padding-bottom: 8mm;
            margin-bottom: 20mm;
        }

        .cover-brand {
            font-size: 24pt;
            font-weight: 900;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .cover-brand .logo-white { color: #ffffff; }
        .cover-brand .logo-gold { color: var(--dourado); }

        .cover-subbrand {
            font-size: 9pt;
            color: #888888;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-top: 3px;
        }

        .cover-body {
            margin-top: 25mm;
        }

        .cover-tag {
            display: inline-block;
            background-color: rgba(197, 160, 89, 0.15);
            color: var(--dourado);
            font-size: 10pt;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 3px;
            padding: 6px 16px;
            border-radius: 4px;
            border: 1px solid var(--dourado);
            margin-bottom: 10mm;
        }

        .cover-title {
            font-size: 38pt;
            font-weight: 900;
            line-height: 1.1;
            margin: 0 0 8mm 0;
            text-transform: uppercase;
            color: #ffffff;
            letter-spacing: -1px;
