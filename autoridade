<script>
function carregarLayoutGlobal() {
fetch('index.html')
.then(response => response.text())
.then(html => {
const parser = new DOMParser();
const doc = parser.parseFromString(html, 'text/html');

const nav = doc.querySelector('.article-nav');
const catNav = doc.querySelector('.editorial-nav-wrapper');
