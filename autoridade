audioBtn.setAttribute('onclick', 'toggleAudio()');
audioBtn.innerHTML = '▶ Ouvir Artigo';
navActions.insertBefore(audioBtn, navActions.children[1] || null);
}

const filterBtns = headerContainer.querySelectorAll('.filter-btn');
filterBtns.forEach(btn => {
btn.setAttribute('onclick', "window.location.href='https://www.youpconsultoria.com/index.html'");
});

const searchInput = headerContainer.querySelector('#searchInput');
if (searchInput) {
searchInput.setAttribute('onkeyup', "window.location.href='https://www.youpconsultoria.com/index.html'");
}
}

const footer = doc.querySelector('.site-footer') || doc.querySelector('footer');
const footerContainer = document.getElementById('footer-global');

if (footerContainer && footer) {
footerContainer.innerHTML = footer.outerHTML;
}
})
.catch(err => console.error('Erro ao carregar layout global:', err));
}

function carregarRecomendados() {
fetch('index.html')
.then(response => response.text())
.then(html => {
const parser = new DOMParser();
const doc = parser.parseFromString(html, 'text/html');
const todosArtigos = Array.from(doc.querySelectorAll('#sourceArticles a'));

const urlAtual = window.location.pathname.split('/').pop() || window.location.pathname;

const artigosFiltrados = todosArtigos.filter(a => {
const href = a.getAttribute('href');
if (!href) return false;
if (href.includes(urlAtual) || urlAtual.includes(href)) return false;

const dataAgendada = a.getAttribute('data-publish-date');
if (dataAgendada) {
const dataPublicacao = new Date(dataAgendada + 'T00:00:00-03:00');
const dataAtual = new Date();
if (dataAtual < dataPublicacao) {
return false;
}
}
return true;
});

const recomendados = artigosFiltrados.slice(0, 3);
const grid = document.getElementById('relatedArticlesGrid');

if (!grid) return;
grid.innerHTML = '';

recomendados.forEach(item => {
const url = item.getAttribute('href');
const imgEl = item.querySelector('img');
const imgSrc = imgEl ? imgEl.getAttribute('src') : '';

const tagEl = item.querySelector('.tag');
const tag = tagEl ? tagEl.innerText : 'YOUP';

const titleEl = item.querySelector('.title') || item.querySelector('h3') || item.querySelector('h4');
const title = titleEl ? titleEl.innerText : item.innerText;

grid.innerHTML += `
<a href="${url}" class="coluna-news-card">
<img src="${imgSrc}" class="coluna-news-img" alt="${title}">
<div class="coluna-news-body">
<span class="coluna-news-tag">${tag}</span>
<h4 class="coluna-news-title">${title}</h4>
</div>
</a>
`;
});
})
.catch(err => console.log('Aviso: Erro ao buscar index.html', err));
}

document.addEventListener("DOMContentLoaded", () => {
carregarLayoutGlobal();
carregarRecomendados();

// Script dinâmico para buscar outras colunas do autor
